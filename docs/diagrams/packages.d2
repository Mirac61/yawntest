# Package dependencies, shortcuts left out. Render: see docs/diagrams/README.md
direction: down

classes: {
  pkg: {style.border-radius: 8}
  leaf: {style.border-radius: 8; style.stroke-dash: 3}
}

cmd: "cmd/lazytest\nflags, wiring" {class: pkg}
report: "report\ntext, JSON, exit code" {class: pkg}
changes: "changes\ngit diff HEAD" {class: pkg}
scan: "scan\nwalk and parse" {class: pkg}
gen: "gen\nwrite test files" {class: pkg}
detect: "detect\nAST rules" {class: leaf}
run: "run\ngo test" {class: leaf}

cmd -> report
cmd -> changes
report -> scan
report -> gen
changes -> scan
changes -> run
scan -> detect
gen -> detect
gen -> run
