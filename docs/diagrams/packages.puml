@startuml packages
!pragma layout smetana
title Package dependencies
skinparam componentStyle rectangle

component "cmd/lazytest" as cmd
component "report\ntext + JSON output,\nexit-code decision" as report
component "changes\nlines changed\nsince HEAD" as changes
component "scan\nwalk, parse,\ndrop tested matches" as scan
component "gen\nmatches → gofmt'ed\ntest file" as gen
component "run\ngo test → findings,\nerror paths" as run
component "detect\nAST → matches, hints\n(no disk access)" as detect

cmd --> report
cmd --> changes
cmd --> scan
cmd --> gen
cmd --> run

report --> scan
report --> gen
report --> run

changes --> scan
changes --> run
changes --> detect

scan --> detect
gen --> detect
gen --> run

note bottom of detect
  detect and run use only
  the standard library
end note
@enduml
