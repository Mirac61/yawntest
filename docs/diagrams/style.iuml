' Shared look for all diagrams. These are the light colors; render.sh adds the dark ones.
!$bg = "#FFFFFF"
!$fg = "#1F2330"
!$box = "#F4F5FA"
!$line = "#5B6275"
!$accent = "#6B4FBB"

skinparam backgroundColor $bg
skinparam defaultFontName Helvetica
skinparam defaultFontSize 15
skinparam defaultFontColor $fg
skinparam shadowing false
skinparam roundCorner 14
skinparam padding 10
skinparam nodesep 70
skinparam ranksep 80
skinparam ArrowColor $line
skinparam ArrowThickness 1.4
skinparam ArrowFontColor $fg
skinparam ArrowFontSize 13

skinparam activity {
  BackgroundColor $box
  BorderColor $accent
  BorderThickness 1.5
  DiamondBackgroundColor $box
  DiamondBorderColor $accent
  StartColor $accent
  EndColor $accent
  BarColor $accent
}
skinparam ActivityDiamondFontSize 15

skinparam package {
  BackgroundColor $box
  BorderColor $accent
  BorderThickness 1.5
  FontSize 16
  FontStyle bold
}
skinparam label {
  FontSize 14
}

' The stop node ignores the activity block, so its color is set on its own.
<style>
activityDiagram {
  circle {
    BackgroundColor $accent
    LineColor $accent
  }
}
</style>
