		{name: "space", input: Handle(" ")},
		{name: "single char", input: Handle("a")},
		{name: "very long", input: Handle(strings.Repeat("x", 10000))},
		{name: "unicode", input: Handle("ünïcødé")},
		{name: "emoji", input: Handle("😀")},
		{name: "null byte", input: Handle("\x00")},
		{name: "sql injection", input: Handle("' OR 1=1 --")},
